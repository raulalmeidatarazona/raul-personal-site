---
import '../styles/site.css';
import '../styles/photos-talks.css';
const { title = 'Raúl Almeida — Backend engineering & architecture', description = 'Practical backend engineering, reliable systems and the decisions behind them. Raúl Almeida, based in Malta.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f9f8f6"/><title>{title}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header wrap"><a class="brand" href="/" aria-label="Raúl Almeida home"><span class="monogram">ra.</span><span>Raúl Almeida<span class="brand-sub">ENGINEERING & ARCHITECTURE</span></span></a><nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#notes">Notes</a><a href="/#videos">Videos</a><a href="/#talks">Talks</a><a href="/#about">About</a><a class="nav-contact" href="mailto:raul.almeida@arsoluciondigital.com">Let’s talk <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot/></main>
<footer class="wrap footer"><a class="brand" href="/">ra.</a><p>Built with care. Kept deliberately simple.</p><a href="https://github.com/raulalmeidatarazona" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/almeidaraul/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><span class="mono">MALTA · EUROPE</span></footer>
</body></html>
<style>
  @media (max-width: 360px) {
    .header { flex-wrap: wrap; gap: 8px; }
    .header nav { width: 100%; justify-content: space-between; }
  }
</style>
