---
import type { Article } from '../data/articles';
import { articleDate } from '../data/articles';
interface Props { article: Article; index: number; }
const { article, index } = Astro.props;
---
<a class="note-row" href={`/p/${article.slug}/`}>
  <span class="mono note-index">{String(index + 1).padStart(2, '0')}</span>
  <div>
    <span class="eyebrow">{article.topic}</span>
    <h3 lang={article.language}>{article.title}</h3>
    <p lang={article.language}>{article.summary}</p>
    <span class="note-language mono"><time datetime={article.publishedAt}>{articleDate(article)}</time> · {article.language === 'es' ? 'ESPAÑOL' : 'ENGLISH'}{article.seriesPosition ? ` · LEGACY TO EVENTS / ${article.seriesPosition} OF 4` : ''}</span>
  </div>
  <span class="row-arrow" aria-hidden="true">→</span>
</a>
