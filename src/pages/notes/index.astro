---
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { articles, legacySeries } from '../../data/articles';
import '../../styles/articles.css';
---
<Layout title="Writing & engineering notes — Raúl Almeida" description="Published articles on legacy integrations, Go, reliable events and engineering workflow. Original English and Spanish editions." noindex>
  <section class="wrap section writing-library">
    <a class="text-link" href="/#notes">← Back to the selection</a>
    <header class="writing-intro"><span class="eyebrow">WRITING / THE PUBLISHED ARCHIVE</span><h1>The reasoning<br/><em>behind the system.</em></h1><p class="intro">Six published articles on integration boundaries, reliable events and engineering workflow. Original language, original dates. More room for the details.</p></header>
    <section class="writing-series" id="legacy-to-events" aria-labelledby="series-heading">
      <span class="eyebrow">A FOUR-PART READING PATH · ENGLISH</span>
      <h2 id="series-heading">From legacy systems to reliable events.</h2>
      <p>Start with the polling problem, follow changes through MySQL, establish an event contract, then handle duplicates and protect the domain.</p>
      <ol class="series-list">{legacySeries.map(article => <li><a href={`/p/${article.slug}/`}><span class="mono">0{article.seriesPosition}</span><strong>{article.title}</strong></a></li>)}</ol>
    </section>
    <div class="section-heading"><div><span class="eyebrow">THE COMPLETE ARCHIVE</span><h2>All published articles.</h2></div><p>Newest first. English and Spanish,<br/>each in its original edition.</p></div>
    <div class="notes-list">{articles.map((article, index) => <ArticleRow article={article} index={index} />)}</div>
    <footer class="writing-footer"><p>Reading preview: these are copies of existing publications, not rewritten editions. Substack remains available for the originals and subscriptions.</p><a class="text-link" href="https://raulalmeidablog.substack.com/" target="_blank" rel="noopener noreferrer">Visit the publication on Substack ↗</a></footer>
  </section>
</Layout>
