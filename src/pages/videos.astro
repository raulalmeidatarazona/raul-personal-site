---
import Layout from '../layouts/Layout.astro';
import ShortCard from '../components/ShortCard.astro';
import { videos } from '../data/videos';
import '../styles/videos.css';
---
<Layout title="Short videos — Raúl Almeida" description="Six short explanations about technical decisions, business operations and knowing what to change. Original audio in Spanish.">
  <section class="wrap section video-library">
    <a class="text-link" href="/#videos">← Back to the selection</a>
    <header class="collection-intro">
      <span class="eyebrow">SHORT VIDEOS / A THEMATIC COLLECTION</span>
      <h1>Better technical decisions.<br/><em>One problem at a time.</em></h1>
      <p class="intro">Technical decisions for growing businesses: from disconnected tools to modernisation and AI. Six short explanations, arranged as a suggested path — not a course.</p>
      <div class="collection-meta mono"><span>6 VIDEOS</span><span>ORIGINAL AUDIO IN SPANISH</span><a href="https://www.youtube.com/@raulalmeida5710/shorts" target="_blank" rel="noopener noreferrer">THE YOUTUBE CHANNEL ↗</a></div>
    </header>
    <div class="series-context"><span class="eyebrow">A SUGGESTED WATCHING ORDER</span><p>Spot the fragmentation. Understand the cost. Question the response. Then decide what to change.</p></div>
    <div class="shorts-grid">{videos.map((video, index) => <ShortCard video={video} sequence={index + 1} />)}</div>
    <div class="collection-end"><p>YouTube holds the originals. This collection adds context and a place to start.</p><a class="text-link" href="/#talks">Prefer a longer conversation? Explore the talks →</a></div>
  </section>
</Layout>
